# ==== Radar Rojo — configuración (Fase 1) ====
# Copia este archivo a ".env" y rellena tus tres claves.
# El archivo .env NUNCA se comparte ni se sube a ningún lado.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=pega_aqui_el_token_de_BotFather
TELEGRAM_CHAT_ID=6806509153

# --- API-Football (registro directo en api-sports.io) ---
API_FOOTBALL_KEY=pega_aqui_tu_api_key
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# --- Comportamiento del monitor ---
# Intervalo entre consultas al partido, en segundos.
# OJO cupo Free: 100 req/día. Un partido dura ~105 min con descuentos.
#   75s  -> ~84 requests por partido  (seguro, deteccion hasta 75s de lag)
#   60s  -> ~105 requests             (se pasa del cupo en un partido completo)
# Deja 75 salvo que sepas lo que haces.
POLL_INTERVAL_SECONDS=75

# Intervalo del RADAR GLOBAL (run_radar.py): escanea TODOS los partidos con 1
# request por ciclo. 900s = 15 min (~96 req/día si corre 24h). Bajarlo da menos
# latencia pero más consumo; a menos de ~15 min, 24h no cabe en el plan Free.
GLOBAL_POLL_INTERVAL_SECONDS=900

# Tope de seguridad de requests por día (UTC). El monitor se detiene si lo alcanza.
# Se deja margen bajo el limite real de 100 del plan Free.
MAX_REQUESTS_PER_DAY=95
